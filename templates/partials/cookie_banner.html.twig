<section class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-100 shadow-lg" id="cookie-banner">
    <div class="max-w-7xl mx-auto sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex gap-3 items-start">
                <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <div>
                    <h4 class="text-sm font-semibold text-gray-800">Gestion des cookies</h4>
                    <p class="text-sm text-gray-500">Ce site utilise des cookies pour améliorer votre expérience. <a href="{{ path('app_politique_confidentialite') }}" class="text-orange-600 hover:underline font-medium">En savoir plus</a></p>
                </div>
            </div>
            <div class="flex gap-2 shrink-0">
                <button onclick="setCookieConsent(false, false)" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200">Refuser</button>
                <button onclick="showCookiePreferences()" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-300">Personnaliser</button>
                <button onclick="setCookieConsent(true, true)" class="px-5 py-2.5 bg-orange-500 text-white rounded-lg text-sm font-semibold hover:bg-orange-600 shadow">Accepter</button>
            </div>
        </div>
    </div>
</section>

<script>
function setCookieConsent(analytics, marketing) {
    const prefs = JSON.stringify({ analytics, marketing });
    const expiry = new Date();
    expiry.setMonth(expiry.getMonth() + 6);
    document.cookie = 'aksamConsent=' + encodeURIComponent(prefs) + '; path=/; expires=' + expiry.toUTCString() + '; SameSite=Lax';
    document.getElementById('cookie-banner').style.display = 'none';
}

function showCookiePreferences() {
    document.getElementById('cookie-preferences').classList.remove('hidden');
    document.getElementById('cookie-banner').classList.add('hidden');
}

document.addEventListener('DOMContentLoaded', function() {
    const consent = document.cookie.match(/aksamConsent=([^;]+)/);
    if (consent) {
        document.getElementById('cookie-banner').style.display = 'none';
    }
});
</script>

<div id="cookie-preferences" class="hidden fixed inset-0 bg-black/50 z-[99]" onclick="hideCookiePreferences()">
    <div class="fixed inset-0 z-[100] flex items-center justify-center p-4" role="dialog" aria-modal="true">
        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full border border-gray-100 overflow-hidden" onclick="event.stopPropagation()">
            <div class="bg-orange-500 px-6 py-4">
                <h3 class="text-lg font-bold text-white">Paramètres de confidentialité</h3>
            </div>
            <div class="p-6 space-y-4">
                <div class="flex items-start justify-between p-3 bg-gray-50 rounded-lg">
                    <div class="flex-1">
                        <h4 class="font-semibold text-sm mb-1">Cookies analytiques</h4>
                        <p class="text-xs text-gray-500">Nous permettent d'améliorer le site.</p>
                    </div>
                    <button onclick="toggleAnalytics()" id="analytics-toggle" class="relative w-12 h-6 rounded-full shrink-0 transition-colors bg-orange-500">
                        <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform translate-x-6"></span>
                    </button>
                </div>
                <div class="flex items-start justify-between p-3 bg-gray-50 rounded-lg">
                    <div class="flex-1">
                        <h4 class="font-semibold text-sm mb-1">Cookies marketing</h4>
                        <p class="text-xs text-gray-500">Campagnes publicitaires personnalisées.</p>
                    </div>
                    <button onclick="toggleMarketing()" id="marketing-toggle" class="relative w-12 h-6 rounded-full shrink-0 transition-colors bg-orange-500">
                        <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform translate-x-6"></span>
                    </button>
                </div>
            </div>
            <div class="flex gap-3 px-6 py-4 bg-gray-50 border-t border-gray-100">
                <button onclick="hideCookiePreferences()" class="px-5 py-2.5 bg-gray-200 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-300">Fermer</button>
                <button onclick="saveCookieConsent()" class="px-5 py-2.5 bg-orange-500 text-white rounded-lg text-sm font-medium hover:bg-orange-600 shadow">Enregistrer</button>
            </div>
        </div>
    </div>
</div>

<script>
let analyticsValue = true;
let marketingValue = true;

function hideCookiePreferences() {
    document.getElementById('cookie-preferences').classList.add('hidden');
}

function toggleAnalytics() {
    analyticsValue = !analyticsValue;
    const toggle = document.getElementById('analytics-toggle');
    if (analyticsValue) {
        toggle.classList.add('bg-orange-500');
        toggle.classList.remove('bg-gray-300');
        toggle.querySelector('span').classList.add('translate-x-6');
    } else {
        toggle.classList.remove('bg-orange-500');
        toggle.classList.add('bg-gray-300');
        toggle.querySelector('span').classList.remove('translate-x-6');
    }
}

function toggleMarketing() {
    marketingValue = !marketingValue;
    const toggle = document.getElementById('marketing-toggle');
    if (marketingValue) {
        toggle.classList.add('bg-orange-500');
        toggle.classList.remove('bg-gray-300');
        toggle.querySelector('span').classList.add('translate-x-6');
    } else {
        toggle.classList.remove('bg-orange-500');
        toggle.classList.add('bg-gray-300');
        toggle.querySelector('span').classList.remove('translate-x-6');
    }
}

function saveCookieConsent() {
    setCookieConsent(analyticsValue, marketingValue);
    hideCookiePreferences();
}
</script>
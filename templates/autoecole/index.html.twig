{% extends 'base.html.twig' %}

{% block title %}Assurance auto-école - RC PRO auto-école{% endblock %}

{% block meta %}
<meta name="description" content="Devis assurance pour auto-école rapide, un comparatif pour RC PRO auto-école en ligne.">
<meta name="keywords" content="Assurance auto-école, RC PRO auto-école, Devis assurance auto-école">
{% endblock %}

{% block body %}
    {{ include('partials/header.html.twig') }}
    
    <main id="main-content" class="flex-1">
        {# Hero Section with Form #}
        <section class="py-12 lg:py-20 bg-white hero-pattern relative overflow-hidden">
            <div class="absolute inset-0 scanlines-bg opacity-30"></div>
            <div class="absolute top-10 left-10 floating-animation"><i class="fas fa-car text-orange-400 text-6xl opacity-30"></i></div>
            <div class="absolute bottom-10 right-10 floating-animation"><i class="fas fa-shield-alt text-orange-500 text-8xl opacity-25"></i></div>

            <div class="max mx-auto sm:px-6 lg:px-8 relative z-10">
                <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 lg:items-stretch">
                    <div class="w-full lg:w-1/2 order-2 lg:order-1 flex">
                        <div class="relative w-full h-full min-h-[400px]">
                            <img src="https://assurance-professionnels-auto.fr/image/photautoecole.png" alt="Assurance RC Pro auto-école" class="absolute inset-0 w-full h-full object-cover rounded-2xl shadow-2xl" />
                        </div>
                    </div>

                    <div class="w-full lg:w-1/2 order-1 lg:order-2 flex">
                        {{ include('partials/form_partial.html.twig', {'form': form, 'title': 'Obtenez un devis gratuit', 'subtitle': 'Complétez en 2 minutes'}) }}
                    </div>
                </div>
            </div>
        </section>

        {# Section 1 - Définition #}
        <section class="py-20 bg-gray-50">
            <div class="max-w-3xl mx-auto sm:px-6 lg:px-8 text-center">
                <h2 className="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Assurance auto-école</h2>
                <h3 className="text-xl font-semibold text-gray-700 mb-6">Définition</h3>
                <p className="text-gray-600 text-lg leading-relaxed">
                    L'assurance auto-école est une couverture spécialement conçue pour les professionnels qui exploitent une auto-école et dispensent des cours de conduite. Ce type d'assurance est essentiel pour couvrir les risques spécifiques liés à l'enseignement de la conduite, à la fois pour le matériel (les véhicules de l'auto-école) et pour les élèves, instructeurs et tiers.
                </p>
            </div>
        </section>

        {# Section 2 - Garanties #}
        <section class="py-20 md:py-28 bg-white" id="garanties">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2 className="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Garanties assurance auto-école</h2>
                    <p className="text-gray-600 max-w-2xl mx-auto text-lg leading-relaxed">
                        Les garanties incluses dans une assurance auto-école peuvent couvrir :
                    </p>
                </div>
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                    {# Guarantees will be populated dynamically #}
                </div>

                {/* Summary paragraph */}
                <p className="mt-12 text-center text-gray-600 text-base max-w-3xl mx-auto leading-relaxed">
                    En résumé, l'assurance auto-école offre une protection complète pour les risques spécifiques liés à l'enseignement de la conduite, incluant à la fois la responsabilité des moniteurs, la sécurité des élèves, ainsi que la protection des véhicules et des locaux de l'auto-école.
                </p>
            </div>
        </section>

        {# Section 3 - Devis #}
        <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 my-16 text-center">
            <h2 className="text-2xl font-bold mb-4">Devis assurance auto-école</h2>
            <p className="text-base text-gray-600">
                Pour obtenir un devis assurance auto-école, veuillez compléter le formulaire en haut de la page. Simple et rapide, obtenez votre devis en ligne et en quelques clics.
            </p>
        </section>

        {# Back to Home Button #}
        <div class="flex justify-center my-12">
            <a href="{{ path('app_home') }}" class="inline-flex items-center gap-3 bg-white text-[#312a8b] font-bold py-4 px-10 rounded-2xl hover:bg-indigo-50 transition-all transform hover:scale-105 shadow-2xl cursor-pointer">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M15 10H5M5 10L10 5M5 10L10 15" stroke="#312a8b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Retour à l'accueil
            </a>
        </div>

        {{ include('partials/cookie_banner.html.twig') }}
    </main>

    {{ include('partials/footer.html.twig') }}
{% endblock %}